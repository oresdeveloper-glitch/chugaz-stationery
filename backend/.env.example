# Copy to .env and adjust. Used by backend/server.js and seed.js
PORT=4000
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_EMAIL=admin@shop.com
ADMIN_PASSWORD=admin123
# Serve the built frontend from /frontend/dist (set to 1 in production)
SERVE_FRONTEND=1
# DB_PATH defaults to backend/data/stationery.db
