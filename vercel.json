{"version":2,"outputDirectory":"frontend/dist","buildCommand":"cd frontend && npm install && npm run build","installCommand":"npm install && (cd backend && npm install) && (cd api && npm install)","regions":["iad1"],"builds":[{"src":"frontend/package.json","use":"@vercel/static-build","config":{"distDir":"dist"}},{"src":"api/index.js","use":"@vercel/node","config":{"includeFiles":["api/backend/**"],"maxLambdaSize":"10mb"}}],"rewrites":[{"source":"/api/:path*","destination":"/api"},{"source":"/assets/:path*","destination":"/frontend/assets/:path*"},{"source":"/uploads/:path*","destination":"/frontend/uploads/:path*"},{"source":"/logo.png","destination":"/frontend/logo.png"},{"source":"/logo.svg","destination":"/frontend/logo.svg"},{"source":"/logo-classic.svg","destination":"/frontend/logo-classic.svg"},{"source":"/logo-auth.png","destination":"/frontend/logo-auth.png"},{"source":"/logo-doc.png","destination":"/frontend/logo-doc.png"},{"source":"/manifest.json","destination":"/frontend/manifest.json"},{"source":"/404.html","destination":"/frontend/404.html"},{"source":"/((?!api/).*)","destination":"/frontend/index.html"}]}